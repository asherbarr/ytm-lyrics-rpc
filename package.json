{
  "name": "ytm-lyrics-rpc",
  "version": "1.0.0",
  "description": "YouTube Music desktop wrapper with synced lyrics and Discord Rich Presence",
  "private": true,
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "@xhayper/discord-rpc": "^1.3.4"
  },
  "build": {
    "appId": "com.osher.ytmlyricsrpc",
    "productName": "YouTube Music",
    "files": [
      "src/**/*",
      "build/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon-ytm-v2.png",
      "category": "AudioVideo"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
